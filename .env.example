# Supabase runtime configuration for the API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-server-only-key

# Required for stateless sessions on Vercel.
SESSION_SECRET=replace-with-a-long-random-value

# Recommended: set all passwords in Vercel instead of using local defaults.
TAREAS_TEACHER_PASSWORD=replace-with-teacher-password
TAREAS_PASSWORD_1A=replace-with-course-1a-password
TAREAS_PASSWORD_2A=replace-with-course-2a-password
TAREAS_PASSWORD_3A=replace-with-course-3a-password
TAREAS_PASSWORD_4A=replace-with-course-4a-password
TAREAS_PASSWORD_5A=replace-with-course-5a-password
TAREAS_PASSWORD_6A=replace-with-course-6a-password